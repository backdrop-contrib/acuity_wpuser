<?php
/**
 * @file
 * Manages the migration of users from WordPress to Backdrop CMS.
 */

/**
 * Implements hook_menu().
 *
 * Lives under the Migration Centre's WordPress category path. Canonical tab set:
 * Overview (default; what it does + prerequisite checklist + Run) → Settings.
 * The landing is MENU_CALLBACK (hidden from the admin menu tree); it is reached
 * from the dashboard card, so only the hub shows in the menu.
 */
function acuity_wpuser_menu() {
  $items = array();

  $items['admin/config/acuity-migration/wordpress/users'] = array(
    'title' => 'User Migration',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('acuity_wpuser_overview_form'),
    'access arguments' => array('administer users'),
    'type' => MENU_CALLBACK,
  );
  $items['admin/config/acuity-migration/wordpress/users/overview'] = array(
    'title' => 'Overview',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  );
  $items['admin/config/acuity-migration/wordpress/users/settings'] = array(
    'title' => 'Settings',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('acuity_wpuser_settings_form'),
    'access arguments' => array('administer users'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 10,
  );

  return $items;
}

/**
 * Implements hook_acuity_migration_group_info().
 *
 * Registers this tool in the Migration Centre's "wordpress" category.
 */
function acuity_wpuser_acuity_migration_group_info() {
  return array(
    'wpuser' => array(
      'title' => t('User Migration & Auth'),
      'description' => t('Import users, map profiles, and manage password hashing strategies.'),
      'url' => 'admin/config/acuity-migration/wordpress/users',
      'category' => 'wordpress',
      // Tables the user import reads. Hardcoded wp_ prefix (this module is not
      // prefix-aware; see its CLAUDE.md Gotchas).
      'export_tables' => array('wp_users', 'wp_usermeta'),
    ),
  );
}

/**
 * Implements hook_config_info().
 */
function acuity_wpuser_config_info() {
  $prefixes['acuity_wpuser.settings'] = array(
    'label' => t('Acuity WP User Settings'),
    'group' => t('Acuity'),
  );
  return $prefixes;
}

/**
 * Form: User Migration Overview (landing tab).
 *
 * The canonical Overview: a prerequisite checklist (is the WordPress connection
 * set? how many users are already imported?) built with the shared
 * acuity_migration_checklist() widget, plus the Run button. Idempotent, so Run
 * is always available.
 */
function acuity_wpuser_overview_form($form, &$form_state) {
  $config = config('acuity_wpuser.settings');
  $batch_size = $config->get('batch_size') ? $config->get('batch_size') : 50;

  $form['intro'] = array(
    '#markup' => '<p>' . t('Import users from the WordPress source database into Backdrop accounts. The import is idempotent — it can be re-run safely and syncs by the original WordPress user ID.') . '</p>',
  );

  // Prerequisite checklist via the hub's shared widget.
  $connected = function_exists('acuity_wpmc_get_database') && acuity_wpmc_get_database();
  $imported = db_table_exists('field_data_field_wp_guid')
    ? db_query("SELECT COUNT(*) FROM {field_data_field_wp_guid} WHERE entity_type = 'user'")->fetchField()
    : 0;
  $steps = array(
    array(
      'label' => t('WordPress database connection'),
      'state' => $connected ? 'done' : 'todo',
      'link' => array('title' => t('Set up connection'), 'href' => 'admin/config/acuity-migration/wordpress/centre'),
    ),
    array(
      'label' => t('Users imported'),
      'state' => $imported ? 'done' : 'todo',
      'description' => format_plural($imported, '1 account so far', '@count accounts so far'),
    ),
  );
  if (function_exists('acuity_migration_checklist')) {
    $form['checklist'] = acuity_migration_checklist($steps);
  }

  $form['status'] = array(
    '#type' => 'item',
    '#title' => t('Current Configuration'),
    '#markup' => t('Batch Size: @size users per step.', array('@size' => $batch_size)),
  );

  // Members still on a WordPress 6.8+ password can only log in while this
  // module is enabled, so this is the number to watch before uninstalling.
  $wp_bcrypt = db_query("SELECT COUNT(*) FROM {users} WHERE pass LIKE :wp OR pass LIKE :plain", array(
    ':wp' => db_like('$wp$2') . '%',
    ':plain' => db_like('$2y$') . '%',
  ))->fetchField();
  $form['wp_passwords'] = array(
    '#type' => 'item',
    '#title' => t('WordPress 6.8+ passwords'),
    '#markup' => format_plural($wp_bcrypt,
      '1 account still has a WordPress 6.8+ password. It is converted at its first login, which needs this module enabled.',
      '@count accounts still have a WordPress 6.8+ password. Each is converted at its first login, which needs this module enabled.'),
  );

  $form['actions']['#type'] = 'actions';
  $form['actions']['run'] = array(
    '#type' => 'submit',
    '#value' => t('Run User Migration'),
    '#attributes' => array('class' => array('button-primary')),
    '#disabled' => !$connected,
  );

  return $form;
}

/**
 * Submit handler for the User Migration Overview form.
 */
function acuity_wpuser_overview_form_submit($form, &$form_state) {
  // Verify connection API exists
  if (!function_exists('acuity_wpmc_get_database')) {
    backdrop_set_message(t('Error: Acuity Migration Centre module is missing.'), 'error');
    return;
  }

  // Get connection
  $connection = acuity_wpmc_get_database();
  if (!$connection) return;

  // Get total count of users to process
  try {
    $total = $connection->select('wp_users', 'u')->countQuery()->execute()->fetchField();
  } catch (Exception $e) {
    backdrop_set_message(t('Query error: @e', array('@e' => $e->getMessage())), 'error');
    return;
  }

  $config = config('acuity_wpuser.settings');
  $batch_size = $config->get('batch_size') ? $config->get('batch_size') : 50;

  $batch = array(
    'title' => t('Migrating WordPress Users'),
    'operations' => array(
      array('acuity_wpuser_batch_process', array($total, $batch_size)),
    ),
    'finished' => 'acuity_wpuser_batch_finished',
    'file' => backdrop_get_path('module', 'acuity_wpuser') . '/acuity_wpuser.module',
  );

  batch_set($batch);
}

/**
 * Form: Settings (Batch Size only).
 */
function acuity_wpuser_settings_form($form, &$form_state) {
  $config = config('acuity_wpuser.settings');
  $form['#config'] = 'acuity_wpuser.settings';

  $form['batch_size'] = array(
    '#type' => 'number',
    '#title' => t('Batch Size'),
    '#description' => t('Number of users to process per batch step.'),
    '#default_value' => $config->get('batch_size') ? $config->get('batch_size') : 50,
    '#required' => TRUE,
  );

  return system_settings_form($form);
}

/**
 * Batch Operation: Process users.
 */
function acuity_wpuser_batch_process($total, $limit, &$context) {
  if (empty($context['sandbox'])) {
    $context['sandbox']['progress'] = 0;
    $context['sandbox']['max'] = $total;
    $context['sandbox']['last_id'] = 0;
  }

  // Get connection from WPMC API
  if (!function_exists('acuity_wpmc_get_database')) {
    $context['results']['errors'][] = "WPMC module missing.";
    $context['finished'] = 1;
    return;
  }

  $connection = acuity_wpmc_get_database();
  if (!$connection) {
    $context['results']['errors'][] = "Database connection lost.";
    $context['finished'] = 1;
    return;
  }

  try {
    // 1. Get Main User Data
    $query = $connection->select('wp_users', 'u');
    $query->fields('u', array('ID', 'user_login', 'user_pass', 'user_email', 'user_registered', 'display_name', 'user_status'));
    $query->condition('u.ID', $context['sandbox']['last_id'], '>');
    $query->orderBy('u.ID', 'ASC');
    $query->range(0, $limit);
    $results = $query->execute();
  }
  catch (Exception $e) {
    $context['results']['errors'][] = $e->getMessage();
    $context['finished'] = 1;
    return;
  }

  foreach ($results as $wp_user) {
    $account = acuity_wpuser_find_existing($wp_user);
    $is_new_user = FALSE;

    if (!$account) {
      $account = new User();
      $account->is_new = TRUE;
      $account->created = strtotime($wp_user->user_registered);
      $account->notify = FALSE; // Silence emails
      $is_new_user = TRUE;
    }

    // --- Basic Mapping ---
    $account->name = $wp_user->user_login;
    $account->mail = $wp_user->user_email;
    $account->init = $wp_user->user_email;
    $account->status = ($wp_user->user_status == 0) ? 1 : 0; // WP 0 = Active
    $account->field_wp_guid[LANGUAGE_NONE][0]['value'] = $wp_user->ID;

    if (!empty($wp_user->display_name)) {
      $account->field_display_name[LANGUAGE_NONE][0]['value'] = $wp_user->display_name;
    }

    // --- Meta Data Extraction ---
    try {
      $meta_query = $connection->select('wp_usermeta', 'm');
      $meta_query->fields('m', array('meta_key', 'meta_value'));
      $meta_query->condition('m.user_id', $wp_user->ID);
      $meta_query->condition('m.meta_key', array('first_name', 'last_name', 'description', 'wp_capabilities', 'wp_user_level'), 'IN');
      $meta_results = $meta_query->execute()->fetchAllKeyed();

      if (!empty($meta_results['first_name'])) {
        $account->field_first_name[LANGUAGE_NONE][0]['value'] = $meta_results['first_name'];
      }
      if (!empty($meta_results['last_name'])) {
        $account->field_last_name[LANGUAGE_NONE][0]['value'] = $meta_results['last_name'];
      }
      if (!empty($meta_results['description'])) {
        $account->field_wp_bio[LANGUAGE_NONE][0]['value'] = $meta_results['description'];
      }
      if (!empty($meta_results['wp_capabilities'])) {
        $account->field_wp_capabilities[LANGUAGE_NONE][0]['value'] = $meta_results['wp_capabilities'];
        // bbPress "blocked" members must never import as active accounts.
        // The block is a capability (bbp_blocked) in this serialized array,
        // NOT in wp_users.user_status (which stays 0/active for them), so
        // status set from user_status above would wrongly enable them.
        $caps = @unserialize($meta_results['wp_capabilities']);
        if (is_array($caps) && !empty($caps['bbp_blocked'])) {
          $account->status = 0;
        }
      }
      if (isset($meta_results['wp_user_level'])) {
        $account->field_wp_user_level[LANGUAGE_NONE][0]['value'] = $meta_results['wp_user_level'];
      }
    }
    catch (Exception $e) {
      // Meta fetch failed, continue
    }

    // --- Save User ---
    try {
      $account->save();

      // SECURITY: Safe Password Injection
      $should_update_pass = FALSE;

      if ($is_new_user) {
        $should_update_pass = TRUE;
      }
      elseif ($account->uid == 1) {
        $should_update_pass = FALSE;
      }
      elseif (!empty($account->pass)) {
         // Check if current hash is Backdrop style ($S)
         $is_backdrop_hash = (substr($account->pass, 0, 3) === '$S$');
         if (!$is_backdrop_hash) {
             $should_update_pass = TRUE;
         }
      }

      if ($should_update_pass) {
        db_update('users')
          ->fields(array('pass' => $wp_user->user_pass))
          ->condition('uid', $account->uid)
          ->execute();
      }

      $context['results']['processed']++;
    }
    catch (Exception $e) {
      $context['results']['errors'][] = "Failed ID {$wp_user->ID}: " . $e->getMessage();
    }

    $context['sandbox']['progress']++;
    $context['sandbox']['last_id'] = $wp_user->ID;
  }

  if ($context['sandbox']['progress'] != $context['sandbox']['max']) {
    $context['finished'] = $context['sandbox']['progress'] / $context['sandbox']['max'];
  }
}

/**
 * Helper: Find existing user by WP GUID or Email.
 */
function acuity_wpuser_find_existing($wp_user) {
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'user')
    ->fieldCondition('field_wp_guid', 'value', $wp_user->ID);
  $result = $query->execute();

  if (isset($result['user'])) {
    $uids = array_keys($result['user']);
    return user_load(reset($uids));
  }

  $account = user_load_by_mail($wp_user->user_email);
  if ($account) {
    return $account;
  }

  $account = user_load_by_name($wp_user->user_login);
  if ($account) {
    return $account;
  }

  return FALSE;
}

/**
 * Batch Finished Callback.
 */
function acuity_wpuser_batch_finished($success, $results, $operations) {
  if ($success) {
    $message = format_plural(isset($results['processed']) ? $results['processed'] : 0, 'One user processed.', '@count users processed.');
    backdrop_set_message($message);
  }
  else {
    backdrop_set_message(t('Finished with an error.'), 'error');
  }

  if (!empty($results['errors'])) {
    foreach ($results['errors'] as $error) {
      backdrop_set_message($error, 'error');
    }
  }
}

/**
 * Implements hook_field_access().
 */
function acuity_wpuser_field_access($op, $field, $entity_type, $entity, $account) {
  $internal_fields = array(
    'field_wp_guid',
    'field_wp_capabilities',
    'field_wp_user_level',
  );

  if (in_array($field['field_name'], $internal_fields)) {
    return user_access('administer users', $account);
  }

  return TRUE;
}
/**
 * Implements hook_form_FORM_ID_alter() for user_login().
 */
function acuity_wpuser_form_user_login_alter(&$form, &$form_state) {
  _acuity_wpuser_add_login_validator($form);
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_block().
 */
function acuity_wpuser_form_user_login_block_alter(&$form, &$form_state) {
  _acuity_wpuser_add_login_validator($form);
}

/**
 * Adds the WordPress password check just before core checks the password.
 *
 * @param array $form
 *   A login form.
 */
function _acuity_wpuser_add_login_validator(array &$form) {
  if (empty($form['#validate'])) {
    return;
  }
  $position = array_search('user_login_authenticate_validate', $form['#validate']);
  if ($position === FALSE) {
    return;
  }
  array_splice($form['#validate'], $position, 0, array('acuity_wpuser_login_validate'));
}

/**
 * Login validator: upgrades a WordPress 6.8+ password hash on a correct login.
 *
 * Backdrop core verifies the older WordPress phpass hashes ($P$, $H$) itself,
 * but not the bcrypt format WordPress 6.8 introduced ($wp$2y$...), so members
 * whose imported password has that format are refused with the right password.
 * When the password matches WordPress's own check, the hash is replaced with a
 * Backdrop one and core's own validator then logs the member in. A wrong
 * password is left for core to refuse and count against flood control.
 */
function acuity_wpuser_login_validate($form, &$form_state) {
  $name = trim($form_state['values']['name']);
  $password = trim($form_state['values']['pass']);
  if (!strlen($name) || !strlen($password)) {
    return;
  }

  // Find the account the way core will.
  $account = FALSE;
  $credentials = config_get('system.core', 'user_login_method');
  if (($credentials === USER_LOGIN_USERNAME_OR_EMAIL || $credentials === USER_LOGIN_EMAIL_ONLY) && valid_email_address($name)) {
    $account = db_query("SELECT uid, pass FROM {users} WHERE mail = :mail AND status = 1", array(':mail' => $name))->fetchObject();
  }
  if (!$account && $credentials !== USER_LOGIN_EMAIL_ONLY) {
    $account = db_query("SELECT uid, pass FROM {users} WHERE name = :name AND status = 1", array(':name' => $name))->fetchObject();
  }
  if (!$account || !acuity_wpuser_is_wp_bcrypt_hash($account->pass)) {
    return;
  }

  // Never test a password where core would refuse to: flood control applies
  // to this check exactly as it does to core's.
  $flood_config = config('user.flood');
  if (!flood_is_allowed('failed_login_attempt_ip', $flood_config->get('flood_ip_limit'), $flood_config->get('flood_ip_window'))) {
    return;
  }
  $identifier = $flood_config->get('flood_uid_only') ? $account->uid : $account->uid . '-' . ip_address();
  if (!flood_is_allowed('failed_login_attempt_user', $flood_config->get('flood_user_limit'), $flood_config->get('flood_user_window'), $identifier)) {
    return;
  }

  // WordPress 6.8+ hashed the password untrimmed; core trims it. Try both, and
  // store the trimmed one, which is what core checks next and at every login.
  $raw = (string) $form_state['values']['pass'];
  if (acuity_wpuser_check_wp_bcrypt_password($raw, $account->pass) || ($raw !== $password && acuity_wpuser_check_wp_bcrypt_password($password, $account->pass))) {
    require_once BACKDROP_ROOT . '/' . settings_get('password_inc', 'core/includes/password.inc');
    $hash = user_hash_password($password);
    if ($hash) {
      db_update('users')
        ->fields(array('pass' => $hash))
        ->condition('uid', $account->uid)
        ->execute();
      entity_get_controller('user')->resetCache(array($account->uid));
      watchdog('acuity_wpuser', 'WordPress password upgraded to a Backdrop hash for user %uid.', array('%uid' => $account->uid));
    }
  }
}

/**
 * Whether a stored hash is one of WordPress's bcrypt formats.
 *
 * @param string $hash
 *   The value of users.pass.
 *
 * @return bool
 *   TRUE for $wp$2y$... (WordPress 6.8+) or a plain $2y$ bcrypt hash.
 */
function acuity_wpuser_is_wp_bcrypt_hash($hash) {
  return strpos($hash, '$wp$2') === 0 || strpos($hash, '$2y$') === 0;
}

/**
 * Checks a password against a WordPress bcrypt hash, as wp_check_password().
 *
 * WordPress 6.8+ pre-hashes the password with HMAC-SHA384 (key "wp-sha384"),
 * base64-encodes it, bcrypts that, and prefixes "$wp". Plain "$2y$" hashes
 * (from plugins) are bcrypt of the password itself.
 *
 * @param string $password
 *   The password as typed.
 * @param string $hash
 *   The stored hash.
 *
 * @return bool
 *   TRUE if the password matches.
 */
function acuity_wpuser_check_wp_bcrypt_password($password, $hash) {
  // As WordPress: longer passwords are not supported.
  if (strlen($password) > 4096) {
    return FALSE;
  }
  if (strpos($hash, '$wp$2') === 0) {
    $prehashed = base64_encode(hash_hmac('sha384', $password, 'wp-sha384', TRUE));
    return password_verify($prehashed, substr($hash, 3));
  }
  if (strpos($hash, '$2y$') === 0) {
    return password_verify($password, $hash);
  }
  return FALSE;
}
